# Model weights and checkpoints stay local (GitHub rejects files over 100 MB).
# /outputs/ is the Run 6 adapter used by the apps; outputs/ folders deeper down
# (gemma-training/) hold committed logs and metrics, with their weights ignored below.
/outputs/
checkpoint-*/
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.gguf
*.onnx

# Downloaded models and Python/Jupyter caches
.cache/
__pycache__/
.pytest_cache/
.ipynb_checkpoints/
